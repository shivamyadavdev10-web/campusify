        {
          "name": "21. Upload Video/PDF (Bunny CDN)",
          "description": "Uploads file to Bunny CDN then saves to DB. If upload fails at any step, orphaned Bunny video is auto-deleted. No DB entry on failure.",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "subjectId",
                  "value": "<ID>",
                  "type": "text"
                },
                {
                  "key": "unit",
                  "value": "Unit 1",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "Lecture 1: Intro to ACN",
                  "type": "text"
                },
                {
                  "key": "type",
                  "value": "video",
                  "type": "text",
                  "description": "video | pdf | notes"
                },
                {
                  "key": "orderSequence",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "Resources",
                  "type": "text",
                  "description": "Optional: Resources, Notes, VVIMP, Question Banks"
                },
                {
                  "key": "bunnyCollectionId",
                  "value": "",
                  "type": "text",
                  "description": "Optional: Bunny Stream Collection GUID (subject folder)"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/content",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "content"
              ]
            }
          }
        },
        {
          "name": "22. Add Content (Link Existing Bunny Video)",
          "description": "Link an already-uploaded Bunny video by its GUID. fileKey is auto-sanitized (strips library prefix).",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
