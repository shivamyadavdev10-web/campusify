            "body": {
              "mode": "raw",
              "raw": "{\n  \"subjectId\": \"<ID>\",\n  \"title\": \"Lecture 2: HLS Stream\",\n  \"type\": \"video\",\n  \"orderSequence\": 2,\n  \"unit\": \"Unit 1\",\n  \"category\": \"Resources\",\n  \"fileKey\": \"c3e819d3-1501-4160-94bc-a9791d2244c1\",\n  \"bunnyLibraryId\": \"722568\",\n  \"bunnyCollectionId\": \"<Collection_ID>\",\n  \"isFree\": false\n}"
