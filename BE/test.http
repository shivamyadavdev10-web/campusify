# ==========================================
# 1. LOGIN AS ADMIN (Token Lene Ke Liye)
# ==========================================
POST {{baseUrl}}/auth/login
Content-Type: application/json
x-device-id: {{deviceId}}

{
    "email"
    
    
    
    : "shivamy1@gmail.com",
    "password": "shivamy1@" 
}
# 
###

# ==========================================
# 2. CREATE BRANCH (e.g., Computer Engineering)
# ==========================================
POST {{baseUrl}}/admin/branch
Content-Type: application/json
x-device-id: {{deviceId}}
Authorization: Bearer {{adminToken}}

{
    "name": "Civil Engineering",
    "shortName": "CE",
    "description": " cement techology with AI",
    "icon": "https://example.com/ce-icon.png",
    "isActive": true
}
# 🛑 Iska response aane par _id copy kar lijiye.

####

# ==========================================
# 3. CREATE SEMESTER (e.g., Sem 3)
# ==========================================
POST {{baseUrl}}/admin/semester
Content-Type: application/json
x-device-id: {{deviceId}}
Authorization: Bearer {{adminToken}}

{
    "branchId": "6a43dac35f8bc9f5233bedfa", 
    "semNumber": 3,
    "title": "Semester 3 - Core cement with adani",
    "description": "Includes various cement, etc.",
    "price": 99,
    "isActive": true
}
# 🛑 Iska response aane par _id copy kar lijiye.

###

# ==========================================
# 4. CREATE SUBJECT (e.g., Data Structures)
# ==========================================
POST {{baseUrl}}/admin/subject
Content-Type: application/json
x-device-id: {{deviceId}}
Authorization: Bearer {{adminToken}}

{
    "semesterId": "6a43db325f8bc9f5233bedfd",
    "name": "adani cement with AI",
    "subjectCode": "CS3011",
    "credits": 4,
    "description": "cement Trees,AI and adani Graphs "
}
# 🛑 Iska response aane par _id copy kar lijiye.

###

### -----------------------------------------------------------
### 📤 5. FILE UPLOADS (Use Postman for these, kept here for docs)
### -----------------------------------------------------------

# 👉 A. UPLOAD MEDIA (Video/PDF)
# Note: Test this in Postman using form-data
POST {{baseUrl}}/admin/content
Content-Type: multipart/form-data
x-device-id: {{deviceId}}
Authorization: Bearer {{adminToken}}

# Required Form-Data Fields:
# branchId: 6a43dac3...
# semesterId: 6a43db32...
# subjectId: 6a43dc11...
# title: "Lecture 1: Introduction"
# contentType: "Video"
# file: [Attach .mp4 or .pdf here]

###

# 👉 B. BULK STUDENT UPLOAD (CSV)
# Note: Test this in Postman using form-data
POST {{baseUrl}}/admin/users/bulk-upload
Content-Type: multipart/form-data
x-device-id: {{deviceId}}
Authorization: Bearer {{adminToken}}

# Required Form-Data Fields:
# file: [Attach students.csv here]

# ==========================================
# 6. REVOKE ACCESS (Refund)
# ==========================================
POST {{baseUrl}}/admin/revoke-access
Content-Type: application/json
x-device-id: {{deviceId}}
Authorization: Bearer {{adminToken}}

{
    "studentEmail": "student@gmail.com",
    "semesterId": "6a3d04877284c18faef5d4d5"
}


###
# ==========================================
# 📊 GET DASHBOARD STATS (Admin Panel Overview)
# ==========================================
GET {{baseUrl}}/admin/dashboard-stats
Authorization: Bearer {{adminToken}}
x-device-id: {{deviceId}}


###
# ==========================================
# 📢 MAKE SEMESTER PUBLIC / PRIVATE
# ==========================================
PATCH {{baseUrl}}/admin/semester/6a43db325f8bc9f5233bedfd/toggle-publish
Authorization: Bearer {{adminToken}}
x-device-id: {{deviceId}}


